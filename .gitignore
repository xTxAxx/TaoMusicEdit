# ============ 运行期生成的数据（TaoMusicEdit） ============
# vendored 依赖：通过 py -m pip install -r src/webui/requirements.txt 重建
src/webui/_vendor/

# SQLite 检测结果缓存（运行时生成）
src/webui/detect_cache.db
src/webui/detect_cache.db-shm
src/webui/detect_cache.db-wal

# JSON 缓存迁移遗留文件
src/webui/detect_cache.json
src/webui/detect_cache.json.migrated

# 运行时用户设置（workspace / 输出目录 / 参数），由 src/webui/settings.py 生成
src/webui/settings.json

# trimmer 示例脚本运行输出（src/trimmer/examples/usage_example.py 生成）
src/trimmer/examples/output/

# ============ 测试 / 演示用视频素材（避免提交大体积二进制） ============
/input1.mp4
/input2.mp4
/input3.mp4
# 根目录测试视频及「批量裁剪」输出（大体积二进制，不提交）
/*Omg*.mp4
/*Omg*_trim.m4a
# 如后续需要忽略任意目录下的视频素材，可取消下面注释：
